@using WebApplication2.DTO;
@{
	ViewData["Title"] = "Register";
}
@model UserDTO


<div><h2>Register Page</h2></div>

<form class="d-flex justify-content-center flex-column align-items-center w-100">
	<div class="card p-3 m-3 d-flex justify-content-center flex-column align-items-center w-100">
		<input class="px-3 py-2 w-50 mb-3" type="text" name="name" asp-for="Name" placeholder="Name" />
		<input class="px-3 py-2 w-50 mb-3" type="email" name="email" asp-for="Email" placeholder="Email" />
		<input class="px-3 py-2 w-50 mb-3" type="password" name="password" asp-for="Password" placeholder="Password" />
		<input class="px-3 py-2 w-50 mb-3" type="password" name="confirmpassword" asp-for="ConfirmPassword" placeholder="Confirm Password" />
		<button class="btn btn-primary w-25" asp-action="CreateUser">Register</button>

		<p>@ViewBag.ErrorMessage</p>
	</div>
	<a asp-action="Login">Already have account? Log in</a>
</form>
