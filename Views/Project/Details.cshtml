
@{
    ViewBag.Title = "Project Details";
}

@model Portfolio_Management_Application.DTO.GetProjectDTO

<div class="container mt-4">

    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">
            <h3 class="mb-0">Project Details</h3>
        </div>

        <div class="card-body">

            <div class="row">

               
                <div class="col-md-4 text-center mb-4">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl"
                             alt="@Model.Name"
                             class="img-fluid rounded shadow-sm"
                             style="max-height:300px; object-fit:cover;" />
                    }
                    else
                    {
                        <div class="bg-light border rounded p-5 text-muted">
                            No Image Available
                        </div>
                    }
                </div>

                
                <div class="col-md-8">

                    <h2 class="mb-3">@Model.Name</h2>

                    <div class="mb-3">
                        <strong>Description</strong>
                        <p class="text-muted">
                            @Model.Description
                        </p>
                    </div>

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <strong>Technology</strong>
                            <p class="text-muted">
                                @Model.Technology
                            </p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>Cost</strong>
                            <p class="text-muted">
                                ₹ @Model.Cost
                            </p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>Created Date</strong>
                            <p class="text-muted">
                                @Model.CreatedDate
                            </p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <strong>Developer</strong>
                            <p class="text-muted">
                                @Model.User.Name
                            </p>
                        </div>

                    </div>

                    
                    <div class="mt-3">

                        @if (!string.IsNullOrEmpty(Model.LiveUrl))
                        {
                            <a href="@Model.LiveUrl"
                               target="_blank"
                               class="btn btn-success me-2">
                                Live Project
                            </a>
                        }

                        @if (!string.IsNullOrEmpty(Model.GithubUrl))
                        {
                            <a href="@Model.GithubUrl"
                               target="_blank"
                               class="btn btn-dark">
                                GitHub
                            </a>
                        }

                    </div>

                </div>

            </div>

        </div>

        <div class="card-footer text-end">
            <a href="@Url.Action("Index", "Project")"
               class="btn btn-secondary">
                Back to Projects
            </a>
        </div>

    </div>

</div>